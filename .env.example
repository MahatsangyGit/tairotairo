# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/tairo_ampio
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public app URL (SEO, emails, absolute links, CORS default origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra cross-origin frontends allowed to call /api (comma-separated origins)
# CORS_ALLOWED_ORIGINS=https://ampindramo.example.com,https://ampianaro.example.com

# ── Ecosystem subdomains (Tairo ampindramo / ampianaro) ───────────────────────
# Shared cookie Domain for SSO (leading dot). Leave empty in local dev.
# AUTH_COOKIE_DOMAIN=.tairo-ampio.mg
# Host headers (no scheme) used by proxy.ts for Host-based rewrites
# RENTAL_HOST=ampindramo.tairo-ampio.mg
# LEARNING_HOST=ampianaro.tairo-ampio.mg
# Feature flags (default: enabled). Set to "false" to disable a vertical.
# RENTAL_ENABLED=true
# LEARNING_ENABLED=true

# ── Production recommended ────────────────────────────────────────────────────
# Bearer token for /api/cron/* (required in production)
CRON_SECRET=replace-with-a-long-random-secret

# Optional CDN origin for static assets (custom production domain only).
# Ignored on localhost, Vercel preview, and *.vercel.app — those serve /_next from the deploy itself.
# NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# ── Redis (rate limiting + WebSocket pub/sub + file Sharp) ────────────────────
# Required in production. Optional in development (single-instance realtime).
# REDIS_URL=redis://localhost:6379

# WebSocket messagerie (/ws/messaging) : uniquement avec le serveur Node custom
# (`npm run dev` / `server.ts`). Désactivé auto sur Vercel (pas de WS serverless).
# Forcer : NEXT_PUBLIC_MESSAGING_WS_ENABLED=1|0
# NEXT_PUBLIC_MESSAGING_WS_ENABLED=0

# ── Image optimize worker (Sharp hors process HTTP) ───────────────────────────
# auto (défaut): queue en production si REDIS_URL, sinon inline dans l'API
# queue: toujours via BullMQ (nécessite `npm run worker:images`)
# inline: Sharp dans le process API (dev / secours)
# IMAGE_OPTIMIZE_MODE=auto
# IMAGE_OPTIMIZE_TIMEOUT_MS=30000
# IMAGE_WORKER_CONCURRENCY=1

# ── Object storage (avatars, KYC, portfolio, listing covers) ───────────────────
# Default: local filesystem under ./storage (dev / VPS only — not Vercel)
# STORAGE_BACKEND=local
# On Vercel: use private Blob (recommended) or S3. Local FS will fail (ENOENT).
# STORAGE_BACKEND=blob
# BLOB_READ_WRITE_TOKEN= (auto-injected when a Blob store is connected)
# For S3-compatible storage (AWS, MinIO, R2, etc.):
# STORAGE_BACKEND=s3
# S3_BUCKET=tairo-uploads
# S3_REGION=eu-west-1
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── PostgreSQL pool (optional) ────────────────────────────────────────────────
# PG_POOL_MAX=20
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECT_TIMEOUT_MS=10000

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=info

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM is not used — set EMAIL_FROM instead
# EMAIL_FROM="Tairo ampio <noreply@example.com>"

# ── Web push (VAPID) ──────────────────────────────────────────────────────────
# VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# ── Bot protection (Cloudflare Turnstile) ─────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Désactive Turnstile en dev (navigateur intégré Cursor / mode Design) — jamais en prod
# NEXT_PUBLIC_TURNSTILE_SKIP_IN_DEV=true

# ── Server ────────────────────────────────────────────────────────────────────
# HOSTNAME=localhost
# PORT=3000

# ── E2E tests ─────────────────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# BCRYPT_ROUNDS=10
# Number of trusted reverse proxies (only then is X-Forwarded-For used for rate limits)
# TRUSTED_PROXY_COUNT=1

# ── Development / testing only ────────────────────────────────────────────────
# Auto-approve subscription payments (never enable in production)
# SUBSCRIPTION_PAYMENT_SIMULATE=false
# SUBSCRIPTION_MONTHLY_PRICE_MGA=50000
